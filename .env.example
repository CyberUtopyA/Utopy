# Nodo LaPiedra
VITE_LAPIEDRA_BASE_URL=https://lapiedracoffee.com

# Runtime UTOPY v2: activación gradual y conservadora.
VITE_UTOPY_RUNTIME_ENABLED=false
VITE_UTOPY_RUNTIME_MIND_ENABLED=false
VITE_UTOPY_RUNTIME_MIND_SHADOW=true
VITE_UTOPY_RUNTIME_MIND_SAFE_AUTO=false
VITE_UTOPY_RUNTIME_FREQUENCY_ENABLED=false
VITE_UTOPY_RUNTIME_DISCOVERY_ENABLED=false

# Push Bridge propio. La clave privada VAPID vive exclusivamente en el servidor.
VITE_UTOPY_FREQUENCY_PUSH_BASE=

# Nodos que publican catálogo + payment.offer en la misma respuesta.
# Mantener este JSON en una sola línea dentro del .env real.
VITE_LIVE_CATALOG_SOURCES=[{"id":"decohogar","catalogUrl":"https://decohogar.utopy.live/api/catalog-live.php","storeId":"decohogar","authority":"decohogar","originNode":"utopy.node.decohogar","refreshMs":30000}]

# Opcional. Solo hace falta si cambian dominios o se añaden nuevas tarjetas.
VITE_UTOPY_LOYALTY_SOURCES=[{"id":"lapiedra-coffee","nodeId":"utopy.node.lapiedra.coffee","name":"LaPiedra Coffee","emoji":"☕","description":"Pasaporte del Viajero","endpoint":"https://lapiedracoffee.com/api/traveler.php?id={memberId}","memberPlaceholder":"LPV-XXXX-XXXX","required":8},{"id":"decohogar","nodeId":"utopy.node.decohogar","name":"DecoHogar","emoji":"🛋️","description":"Tarjeta de fidelidad","endpoint":"https://decohogar.utopy.live/api/loyalty-passport.php?id={memberId}","memberPlaceholder":"Código o teléfono","required":5}]
