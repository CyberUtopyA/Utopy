# UTOPY conoce la red, no una lista fija de comercios.
VITE_MICELIO_HTTP=https://seed.mterra.space/micelio
VITE_SEED_WS=wss://seed.mterra.space/utopy?ns=mt
VITE_FALCON_MT_NS=mt:market,utopy:nodes,utopy:resonance

# Activación progresiva del Runtime universal.
VITE_UTOPY_RUNTIME_ENABLED=false
VITE_UTOPY_RUNTIME_MIND_ENABLED=false
VITE_UTOPY_RUNTIME_MIND_SHADOW=true
VITE_UTOPY_RUNTIME_MIND_SAFE_AUTO=false
VITE_UTOPY_RUNTIME_FREQUENCY_ENABLED=false
VITE_UTOPY_RUNTIME_DISCOVERY_ENABLED=false
VITE_UTOPY_FREQUENCY_PUSH_BASE=

# Audience propia y anclas PUBLICAS verificadas por el operador.
# Sin anclas y sin authority.trust firmado, las capacidades sensibles se bloquean.
# Formato: [{"authority":"...","keyId":"...","publicKeyJwk":{...}}]
# Nunca colocar claves privadas en VITE_*.
VITE_UTOPY_MARKET_NODE_ID=utopy.node.market.runtime
VITE_UTOPY_TRUST_ANCHORS=[]

# Opcional: solo para arrancar si todavía ningún nodo anunció su manifiesto.
# Debe quedar vacío cuando los nodos ya laten en Seed/Micelio.
VITE_BOOTSTRAP_NODE_SOURCES=[]
